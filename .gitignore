# Игнорировать ВСЁ по умолчанию
*

# НО не игнорировать папки с лабораторными работами
!/Lab_*/
!/Lab_*/*

# Не игнорировать нужные типы файлов внутри этих папок
!*.cpp
!*.h
!*.hpp
!*.txt
!*.md

# Не игнорировать сам .gitignore
!/.gitignore

# Явно игнорировать временные и системные файлы (на всякий случай)
*.exe
*.o
*.obj
*.out
build/
bin/
obj/
.DS_Store
Thumbs.db
*.swp
*.swo